{
  "name": "quan-ly-kho-desktop",
  "productName": "Quản Lý Kho",
  "version": "1.1.0",
  "description": "Phần mềm quản lý kho nội bộ — bản desktop (Electron)",
  "author": "VHP Group",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "sync": "node sync.js",
    "start": "node sync.js && electron .",
    "dist:win": "node sync.js && electron-builder --win",
    "dist:linux": "node sync.js && electron-builder --linux",
    "dist:mac": "node sync.js && electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "vn.vhpgroup.quanlykho",
    "productName": "Quản Lý Kho",
    "files": [
      "main.js",
      "app.html",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png",
      "artifactName": "QuanLyKho-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Quản Lý Kho",
      "artifactName": "QuanLyKho-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "QuanLyKho-Portable-${version}.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png",
      "category": "Office",
      "executableName": "quan-ly-kho",
      "artifactName": "QuanLyKho-${version}.${ext}"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "artifactName": "QuanLyKho-${version}.${ext}"
    }
  }
}
